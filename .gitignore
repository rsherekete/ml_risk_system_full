beta_uvicorn*.log
webapp/artifacts/_server_*.log

# SQLite side-car files: `*.db` is ignored above but its WAL and shared-memory
# companions are separate extensions and were being tracked.
*.db-shm
*.db-wal

# Local snapshots taken before a sync -- a copy of the tree, never pushed.
_backup_before_github_sync_*/
